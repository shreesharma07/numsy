{
  "name": "Numsy: Indian mobile number toolkit",
  "short_name": "Numsy",
  "description": "Validate, sanitize, extract and de-duplicate Indian mobile numbers from CSV/Excel datasets.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FAF6EF",
  "theme_color": "#111111",
  "icons": [
    { "src": "brand/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "brand/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "brand/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "brand/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}
