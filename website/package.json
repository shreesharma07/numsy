{
  "name": "@numsy/website",
  "version": "1.2.0",
  "private": true,
  "description": "Documentation site for Numsy (numsy) — deployed to GitHub Pages.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-brand.mjs && node scripts/build-icons.mjs",
    "dev": "node scripts/sync-brand.mjs && node scripts/build-icons.mjs && vite",
    "build": "node scripts/sync-brand.mjs && node scripts/build-icons.mjs && tsc -b && vite build",
    "build:dashboard": "node scripts/build-icons.mjs && vite build --config vite.dashboard.config.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "check": "biome check .",
    "deploy:cloudflare": "pnpm run build && pnpm dlx wrangler@4 pages deploy dist --project-name numsy --branch main"
  },
  "dependencies": {
    "@iconify/react": "6.0.3",
    "exceljs": "4.4.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@iconify-json/ph": "1.2.2",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
