{
  "name": "@numsy/website",
  "version": "1.2.0",
  "private": true,
  "description": "Documentation site for Numsy (@numsy/numsy) — deployed to GitHub Pages.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-brand.mjs && node scripts/build-icons.mjs",
    "dev": "node scripts/sync-brand.mjs && node scripts/build-icons.mjs && vite",
    "build": "node scripts/sync-brand.mjs && node scripts/build-icons.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "check": "biome check ."
  },
  "dependencies": {
    "@iconify/react": "6.0.2",
    "motion": "12.43.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@iconify-json/ph": "1.2.2",
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
