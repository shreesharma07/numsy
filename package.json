{
  "displayName": "Numsy",
  "name": "@numsy/numsy",
  "version": "1.1.0",
  "description": "Validate, sanitize, extract and de-duplicate Indian mobile numbers from text, CSV and Excel — as a typed TypeScript library, a CLI with JSON/CSV/Markdown/Excel output, and a local web UI.",
  "author": {
    "name": "Shri Kumar Sharma",
    "url": "https://shrikumarsharma.in"
  },
  "private": false,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "numsy": "./dist/cli/index.js",
    "numsy-serve": "./dist/cli/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/core/Parser.d.ts",
      "default": "./dist/core/Parser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "public",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "phone-number",
    "validator",
    "indian-phone",
    "csv-parser",
    "excel-parser",
    "number-processor",
    "numsy",
    "typescript",
    "phone-sanitizer",
    "contact-processor",
    "class-based",
    "phone-validation",
    "cli",
    "india",
    "mobile-number",
    "excel",
    "xlsx",
    "markdown",
    "json",
    "data-cleaning",
    "deduplication"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shreesharma07/numsy.git"
  },
  "bugs": {
    "url": "https://github.com/shreesharma07/numsy/issues"
  },
  "homepage": "https://shreesharma07.github.io/numsy/",
  "engines": {
    "node": ">=18.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "swc src -d dist --copy-files && tsc --emitDeclarationOnly",
    "build:nest": "nest build",
    "dev": "nodemon",
    "dev:server": "nodemon --exec ts-node src/server.ts",
    "serve": "ts-node src/cli/server.ts",
    "serve:prod": "node dist/cli/server.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:nest": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/server.js",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky install",
    "prepublishOnly": "pnpm run build",
    "version": "pnpm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "audit:fix": "pnpm audit --fix",
    "audit:check": "pnpm audit --audit-level=moderate",
    "snyk:test": "snyk test",
    "snyk:monitor": "snyk monitor",
    "snyk:protect": "snyk protect",
    "security:check": "pnpm audit:check && pnpm snyk:test",
    "precommit": "lint-staged",
    "validate": "pnpm run check:ci && pnpm run type-check && pnpm test",
    "ci": "pnpm run validate && pnpm run build",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "release:local": "semantic-release --extends ./.releaserc.local.json --dry-run --no-ci",
    "release:preview": "node scripts/release-preview.js",
    "npm:check": "node scripts/check-npm-status.js",
    "npm:fix-cooldown": "node scripts/fix-npm-cooldown.js",
    "cli": "ts-node src/cli/index.ts",
    "check": "biome check --write .",
    "check:ci": "biome ci ."
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/serve-static": "^4.0.0",
    "archiver": "^6.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "moment-timezone": "^0.5.45",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@codecov/vite-plugin": "^1.9.1",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.3",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@swc/cli": "^0.1.63",
    "@swc/core": "^1.3.105",
    "@types/archiver": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/moment-timezone": "^0.5.30",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "4.0.18",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.0.3",
    "rimraf": "^5.0.5",
    "semantic-release": "^23.1.1",
    "snyk": "^1.1303.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.spec.ts",
      "!src/**/*.test.ts",
      "!src/main.ts",
      "!src/server.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/test/"
    ]
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@>=0.2.0 <1.9.0": ">=1.9.0",
      "cross-spawn@<6.0.6": ">=6.0.6",
      "tmp@<=0.2.3": ">=0.2.4",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "webpack@>=5.49.0 <=5.104.0": ">=5.104.1",
      "webpack@>=5.49.0 <5.104.0": ">=5.104.0",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "multer@<2.1.0": ">=2.1.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "multer@<2.1.1": ">=2.1.1"
    }
  },
  "contributors": [
    {
      "name": "Shri Kumar Sharma",
      "url": "https://github.com/shreesharma07"
    }
  ]
}
