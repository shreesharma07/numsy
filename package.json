{
  "displayName": "Numsy",
  "name": "numsy",
  "version": "2.2.1",
  "description": "Validate, sanitize, extract and de-duplicate Indian mobile numbers from text, CSV and Excel — as a typed TypeScript library, a CLI with JSON/CSV/Markdown/Excel output, and a local dashboard on localhost:6789.",
  "author": {
    "name": "Shri Kumar Sharma",
    "url": "https://shrikumarsharma.in"
  },
  "private": false,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "numsy": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/core/Parser.d.ts",
      "default": "./dist/core/Parser.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "public",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "phone-number",
    "validator",
    "indian-phone",
    "csv-parser",
    "excel-parser",
    "number-processor",
    "numsy",
    "typescript",
    "phone-sanitizer",
    "contact-processor",
    "class-based",
    "phone-validation",
    "cli",
    "india",
    "mobile-number",
    "excel",
    "xlsx",
    "markdown",
    "json",
    "data-cleaning",
    "deduplication",
    "dashboard",
    "phone-validator",
    "indian-mobile"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shreesharma07/numsy.git"
  },
  "bugs": {
    "url": "https://github.com/shreesharma07/numsy/issues"
  },
  "homepage": "https://numsy.pages.dev/",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "rimraf dist && swc src -d dist --copy-files --strip-leading-paths && tsc -p tsconfig.build.json --emitDeclarationOnly --incremental false && pnpm run build:dashboard",
    "build:dashboard": "pnpm --filter @numsy/website build:dashboard",
    "build:nest": "nest build",
    "dev": "nodemon",
    "dev:server": "nodemon --exec ts-node src/server.ts",
    "serve": "ts-node src/cli/server.ts",
    "serve:prod": "node dist/cli/server.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:nest": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/server.js",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --coverage --reporters=default --reporters=jest-junit",
    "codecov": "node scripts/codecov.js",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm run verify:package",
    "version": "pnpm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "audit:fix": "pnpm audit --fix",
    "audit:check": "pnpm audit --audit-level=moderate",
    "snyk:test": "snyk test --all-projects",
    "snyk:monitor": "snyk monitor --all-projects",
    "snyk:code": "snyk code test",
    "security:check": "pnpm audit:check && pnpm snyk:test",
    "precommit": "lint-staged",
    "validate": "pnpm run check:ci && pnpm run type-check && pnpm test",
    "ci": "pnpm run validate && pnpm run build",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "release:local": "semantic-release --extends ./.releaserc.local.json --dry-run --no-ci",
    "release:preview": "node scripts/release-preview.js",
    "npm:check": "node scripts/check-npm-status.js",
    "npm:fix-cooldown": "node scripts/fix-npm-cooldown.js",
    "cli": "ts-node src/cli/index.ts",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "verify:package": "node scripts/verify-package.js",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/serve-static": "^5.0.5",
    "archiver": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parser": "^3.2.1",
    "csv-writer": "^1.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "moment-timezone": "^0.6.5",
    "multer": "^2.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/archiver": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-junit": "17.0.0",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "snyk": "^1.1308.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.spec.ts",
      "!src/**/*.test.ts",
      "!src/main.ts",
      "!src/server.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/test/"
    ]
  },
  "contributors": [
    {
      "name": "Shri Kumar Sharma",
      "url": "https://github.com/shreesharma07"
    }
  ],
  "jest-junit": {
    "outputDirectory": "coverage",
    "outputName": "junit.xml",
    "addFileAttribute": "true",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
