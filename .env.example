# Application Configuration
PORT=6789

# File Upload Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
TEMP_DIR=temp

# Cleanup Configuration (in hours)
FILE_CLEANUP_AGE_HOURS=1

# Codecov upload token (bundle analysis, coverage, test results); set it in .env, never commit it
CODECOV_TOKEN=

# Cloudflare Web Analytics beacon token for the website build; leave empty to build without analytics
CF_WEB_ANALYTICS_TOKEN=
